# ============================================================
# TLD Logistics — نمونه متغیرهای محیطی (.env.example)
# این فایل را به .env کپی کنید و مقادیر واقعی را جایگزین کنید.
# همه متغیرهای سمت کلاینت باید با VITE_ شروع شوند، وگرنه در باندل Vite قرار نمی‌گیرند.
# ============================================================

# --- Supabase (اجباری) ---
# همان پروژه‌ای که migrations داخل پوشه supabase روی آن اجرا شده است.
# نکته: کلید anon عمومی است و در باندل نهایی هم دیده می‌شود؛ امنیت واقعی از RLS می‌آید.
# اگر این دو مقدار تعریف نشوند، اپ روی مقادیر پیش‌فرض «دمو» در
# src/services/supabaseClient.ts و admin/src/lib/supabase.ts بالا می‌آید.
VITE_SUPABASE_URL="https://xucsgbapstfcftwrurhy.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key"

# اگر true باشد، کل اپ با داده‌های نمونه (mock) و بدون اتصال به دیتابیس اجرا می‌شود.
VITE_USE_MOCK_DATA="false"

# --- Google Gemini (اختیاری، برای دستیار هوشمند) ---
# توجه: کلید در باندل مرورگر قرار می‌گیرد؛ برای پروداکشن باید از یک پروکسی سرور استفاده شود.
VITE_GEMINI_API_KEY=""

# نام مدل‌ها (اختیاری). اگر خالی بمانند، مقادیر پیش‌فرض داخل کد استفاده می‌شود.
# با منسوخ شدن مدل‌ها فقط همین مقادیر را عوض کنید، نه کد را.
VITE_GEMINI_MODEL_CHAT="gemini-3.5-flash"
VITE_GEMINI_MODEL_COMPLEX="gemini-3.8-flash"
VITE_GEMINI_MODEL_FAST="gemini-3.5-flash-lite"
VITE_GEMINI_MODEL_AUDIO="gemini-3.5-flash"

# --- درگاه پرداخت (اختیاری / پروداکشن) ---
VITE_PAYMENT_MERCHANT_ID="your-merchant-id"
VITE_PAYMENT_TERMINAL_ID="your-terminal-id"
VITE_PAYMENT_API_URL="https://your-backend-api.com"

# --- آدرس اپ (برای لینک‌های بازگشتی و OAuth) ---
APP_URL="http://localhost:3000"
